{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "aspire",
      "request": "launch",
      "program": "${workspaceFolder}/sample/AppHost/CS2Launcher.Sample.AppHost.csproj",
      "debuggers": {
        "project": {
          "justMyCode": true,
          "logging": {
            "engineLogging": false,
            "moduleLoad": false,
            "threadExit": false
          },
          "requireExactSource": true,
          "sourceLinkOptions": {
            "https://raw.githubusercontent.com/*": {
              "enabled": true
            },
            "*": {
              "enabled": false
            }
          },
          "stopAtEntry": false
        }
      }
    }
  ]
}